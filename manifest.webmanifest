{
  "name": "MetriX Train",
  "short_name": "MetriX",
  "description": "Workout logger with rest timer and week-to-week progression",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#070d1c",
  "theme_color": "#070d1c",
  "shortcuts": [
    { "name": "Start workout", "short_name": "Workout", "url": "./?go=train", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log food", "short_name": "Food", "url": "./?go=fuel", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan barcode", "short_name": "Scan", "url": "./?go=scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log weight", "short_name": "Weight", "url": "./?go=weight", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
